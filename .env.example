# Copie para .env e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Geral > Seus apps > SDK config)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ID do município padrão usado nesta instância do app (multi-tenant)
VITE_MUNICIPIO_ID=irati-pr
